          "name": "Get negotiated rates for a procedure code",
          "request": {
            "name": "Get negotiated rates for a procedure code",
            "description": {
              "content": "Returns payer-negotiated reimbursement rates for a single procedure code (CPT/DRG), optionally filtered by region, tier, site of service, and payer.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "rates",
                "code",
                ":code"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "region",
                  "value": "<string>",
                  "description": "US state abbreviation to scope rates to (e.g. PA)."
                },
                {
                  "disabled": false,
                  "key": "tier",
                  "value": "<string>",
                  "description": "Service tier, e.g. professional or facility."
                },
                {
                  "disabled": false,
                  "key": "site",
                  "value": "<string>",
                  "description": "Site of service, e.g. nonfac (non-facility) or fac (facility)."
                },
                {
                  "disabled": false,
                  "key": "payer",
                  "value": "<string>",
                  "description": "Payer name to filter to (e.g. bcbs, cigna, uhc)."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "code",
                  "description": "(Required) The procedure code (CPT or DRG) to look up."
                }
              ]
            },
            "header": [
