          "id": "9c8c440a-fd61-40bb-9159-693ee7177e8f",
          "name": "Get rate distribution for a procedure code",
          "request": {
            "name": "Get rate distribution for a procedure code",
            "description": {
              "content": "Returns the percentile distribution (5th-95th) of negotiated rates for a single procedure code, filtered by region, tier, site of service, payer, and weighting method.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "distributions",
                "code",
                ":code"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "region",
                  "value": "<string>",
                  "description": "US state abbreviation to scope the distribution to (e.g. TX)."
                },
                {
                  "disabled": false,
                  "key": "tier",
                  "value": "<string>",
                  "description": "Service tier, e.g. professional or facility."
                },
                {
                  "disabled": false,
                  "key": "site",
                  "value": "<string>",
                  "description": "Site of service, e.g. nonfac (non-facility) or fac (facility)."
                },
                {
                  "disabled": false,
                  "key": "payer",
                  "value": "<string>",
                  "description": "Payer name to filter to (e.g. bcbs, cigna, uhc)."
                },
                {
                  "disabled": false,
                  "key": "weighting",
                  "value": "<string>",
                  "description": "Weighting method for the distribution, by ein or npi."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "code",
                  "description": "(Required) The procedure code (CPT or DRG) to look up."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
